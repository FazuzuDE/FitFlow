{
  "name": "fitflow",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "config:check": "node scripts/check-config.cjs && expo config --type public",
    "deps:check": "expo install --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run config:check && npm run deps:check",
    "export:check": "expo export --platform ios --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.25",
    "expo-asset": "~57.0.18",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.8",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  }
}
