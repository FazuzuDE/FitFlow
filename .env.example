# Reserved for the future Oracle API. The current local MVP does not use it.
# EXPO_PUBLIC_* values are public and included in the mobile bundle.
# Never put database credentials, SSH keys or server secrets here.
# EXPO_PUBLIC_API_URL=https://api.example.com

# Optional CRESUM Account (public client values only; never use a service-role key).
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Supabase Email OTP template must include {{ .Token }} (six-digit code).
